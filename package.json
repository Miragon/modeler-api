{
  "name": "modeler-suite",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "modelers/*",
    "modelers/*/packages/*",
    "modelers/*/apps/*",
    "modelers/*/e2e"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:modelers",
    "build:shared": "npm run build -w @miragon/modeler-api -w @miragon/modeler-shell",
    "build:modelers": "npm run modelers build",
    "build:apps": "npm run modelers build:webapp && npm run modelers build:vscode",
    "typecheck": "npm run typecheck:shared && npm run modelers typecheck",
    "typecheck:shared": "npm run typecheck -w @miragon/modeler-api -w @miragon/modeler-shell && tsc -p test/tsconfig.json",
    "lint": "npm run typecheck:shared && npm run modelers lint",
    "test": "npm run test:shared && npm run modelers test",
    "test:shared": "npm run test -w @miragon/modeler-api -w @miragon/modeler-shell && npm run test:plugin",
    "test:plugin": "vitest run --config test/vitest.config.mts",
    "test:browser": "npm run modelers test:browser",
    "test:e2e:shared": "npm run test:e2e -w @miragon/modeler-shell",
    "depcruise": "npm run modelers depcruise",
    "publint": "npm run publint -w @miragon/modeler-api -w @miragon/modeler-shell",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "modelers": "npm run -w @miragon/wardley-modeler-workspace -w @miragon/event-storming-modeler-workspace -w @miragon/team-topologies-modeler-workspace -w @miragon/context-maps-modeler-workspace -w @miragon/value-chain-modeler-workspace",
    "wardley": "npm run -w @miragon/wardley-modeler-workspace",
    "event-storming": "npm run -w @miragon/event-storming-modeler-workspace",
    "team-topologies": "npm run -w @miragon/team-topologies-modeler-workspace",
    "context-maps": "npm run -w @miragon/context-maps-modeler-workspace",
    "value-chain": "npm run -w @miragon/value-chain-modeler-workspace"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@types/node": "26.6.5",
    "vite": "8.3.4"
  }
}
