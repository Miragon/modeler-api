{
  "name": "@miragon/modeler-api",
  "version": "0.1.0",
  "description": "ONE interface every Miragon modeler implements — the collaborative-modeler contract and its conformance test kit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/modeler-api.git"
  },
  "homepage": "https://github.com/Miragon/modeler-api#readme",
  "bugs": "https://github.com/Miragon/modeler-api/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./conformance": {
      "import": {
        "types": "./dist/conformance.d.ts",
        "default": "./dist/conformance.js"
      },
      "require": {
        "types": "./dist/conformance.d.cts",
        "default": "./dist/conformance.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "publint": "publint",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run typecheck && npm run format:check"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "publint": "0.3.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
