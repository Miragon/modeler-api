npx lint-staged

# Lint (ESLint and type check) only the modelers whose code or config the commit touches, and
# type-check the shared packages when they change. A modeler's type check reads the shared
# packages' built types, so a fresh checkout builds them once.
staged=$(git diff --cached --name-only)
modelers=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|mjs|cjs|json)$' | sed -n 's|^modelers/\([^/]*\)/.*|\1|p' | sort -u)
if [ -n "$modelers" ] && { [ ! -f packages/api/dist/index.d.ts ] || [ ! -f packages/shell/dist/index.d.ts ]; }; then
  npm run build:shared
fi
for modeler in $modelers; do
  npm run lint -w "@miragon/$modeler-modeler-workspace"
done
if printf '%s\n' "$staged" | grep -qE '^(packages|test)/.*\.(ts|tsx|json)$'; then
  npm run typecheck:shared
fi
