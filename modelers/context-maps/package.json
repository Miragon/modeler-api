{
  "name": "context-maps-modeler",
  "version": "0.0.1",
  "private": true,
  "description": "A web-based modeler and VS Code extension for DDD Context Maps (bounded contexts & context-mapping relationship patterns), interoperable with Context Mapper CML.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/schema-model",
    "packages/cml",
    "packages/renderer",
    "apps/webapp",
    "apps/vscode",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build -w packages/schema-model -w packages/cml -w packages/renderer",
    "build:webapp": "npm run build -w apps/webapp",
    "build:vscode": "npm run build -w apps/vscode",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/webapp/tsconfig.node.json && npm run typecheck -w apps/vscode && npm run typecheck -w e2e",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project=unit",
    "test:browser": "vitest run --project=browser",
    "test:vscode": "vitest run --project=vscode",
    "test:vscode:docker": "modeler-shell-vscode-docker",
    "test:e2e": "npm run test:e2e -w e2e --",
    "dev": "npm run dev:webapp",
    "dev:webapp": "npm run dev -w apps/webapp",
    "dev:webapp:plain": "npm run dev:app -w apps/webapp",
    "dev:vscode": "npm run watch -w apps/vscode",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yaml,yml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@types/node": "26.6.5",
    "vite": "8.3.4",
    "tsup": {
      "esbuild": "0.25.12"
    }
  }
}
