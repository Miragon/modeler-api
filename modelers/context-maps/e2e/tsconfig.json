{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@miragon/context-maps-schema-model": ["../packages/schema-model/src/index.ts"],
      "@miragon/context-maps-cml": ["../packages/cml/src/index.ts"],
      "@miragon/context-maps-renderer": ["../packages/renderer/src/index.ts"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "webview/**/*.ts",
    "playwright.config.ts",
    "../packages/renderer/src/diagram-js-direct-editing.d.ts",
    "../packages/renderer/src/css.d.ts"
  ]
}
